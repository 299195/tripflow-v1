# Copy to .env locally; never commit real credentials.
TRIPFLOW_DB=tripflow.db
TRIPFLOW_HOST=127.0.0.1
TRIPFLOW_PORT=8000

# Required only for live POI search through Amap Web Service.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=8
AMAP_MAX_RETRIES=2
AMAP_RETRY_BACKOFF_SECONDS=0.2

# Primary place search via Meituan Maps Web Service. Search response has no shop images or introductions.
MEITUAN_MAPS_KEY=

# Optional advisory Agent. Hard constraints remain deterministic code.
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=15
QWEN_ENABLED=1
